  },
  "equipment_sanctify": {
    "description": "P6 神圣化：让装备的下次强化必定成功，规避 +6~+15 的失败概率。一次性消耗，强化后失效。",
    "enabled": true,
    "cost_by_rarity": {
      "common": {"gold": 200, "rune_shard": 5},
      "rare": {"gold": 600, "rune_shard": 15},
      "epic": {"gold": 1500, "rune_shard": 35, "void_fragment": 1},
      "legendary": {"gold": 4000, "rune_shard": 80, "void_fragment": 3},
      "mythic": {"gold": 10000, "rune_shard": 200, "void_fragment": 8}
    },
    "design_note": "为高风险强化（+11~+15 仅 40%）提供保底路径。神圣化后下一次强化必成，但消耗资源相当于一次失败的损失，鼓励玩家在关键档位用，而不是无脑刷。"
  },
