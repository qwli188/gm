  "level_curve": {
    "description": "局内升级所需经验（P6 把上限从50提到60，给巅峰系统留接管点）",
    "formula": "base * (growth ^ (level-1))",
    "base_exp": 10,
    "growth": 1.15,
    "max_level": 60,
