[gd_resource type="Theme" load_steps=10 format=3 uid="uid://darkloot_theme"]

; DarkLoot 全局 Theme 资源
; ============================================================
; 设计：暗黑奇幻 ARPG 风格 — 深色背景、稀有度配色、清晰字体层级
;
; 字体大小层级：
;   - 14: caption（小字、提示）
;   - 18: body（正文，默认）
;   - 24: subtitle（小标题）
;   - 32: title（大标题）
;   - 48: hero（主标题/欢迎屏）
;
; 使用：
;   1. 在 main.tscn 根节点设置 theme = ExtResource("res://theme/darkloot.tres")
;   2. 子节点自动继承样式，不再需要 theme_override_*
;   3. 局部需特殊样式时仍可用 theme_override_*

[sub_resource type="StyleBoxFlat" id="panel_dark"]
bg_color = Color(0.08, 0.08, 0.12, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.4, 0.35, 0.25, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="button_normal"]
bg_color = Color(0.18, 0.16, 0.22, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.45, 0.38, 0.28, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="button_hover"]
bg_color = Color(0.28, 0.24, 0.18, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.85, 0.7, 0.45, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="button_pressed"]
bg_color = Color(0.12, 0.1, 0.08, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.95, 0.8, 0.5, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="progress_bg"]
bg_color = Color(0.08, 0.08, 0.1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.25, 0.2, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="progress_fill"]
bg_color = Color(0.85, 0.25, 0.25, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="line_edit_normal"]
bg_color = Color(0.05, 0.05, 0.08, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.3, 0.22, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2
content_margin_left = 8.0
content_margin_top = 4.0
content_margin_right = 8.0
content_margin_bottom = 4.0

[sub_resource type="StyleBoxFlat" id="popup_panel"]
bg_color = Color(0.06, 0.05, 0.08, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.85, 0.7, 0.45, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0

[resource]
default_font_size = 18

; --- Label ---
Label/colors/font_color = Color(0.92, 0.88, 0.78, 1)
Label/colors/font_outline_color = Color(0, 0, 0, 1)
Label/constants/outline_size = 1
Label/font_sizes/font_size = 18

; --- Button ---
Button/colors/font_color = Color(0.92, 0.88, 0.78, 1)
Button/colors/font_hover_color = Color(1, 0.95, 0.7, 1)
Button/colors/font_pressed_color = Color(1, 0.85, 0.4, 1)
Button/colors/font_disabled_color = Color(0.4, 0.4, 0.4, 1)
Button/styles/normal = SubResource("button_normal")
Button/styles/hover = SubResource("button_hover")
Button/styles/pressed = SubResource("button_pressed")
Button/font_sizes/font_size = 18

; --- Panel/PanelContainer ---
Panel/styles/panel = SubResource("panel_dark")
PanelContainer/styles/panel = SubResource("panel_dark")

; --- ProgressBar ---
ProgressBar/styles/background = SubResource("progress_bg")
ProgressBar/styles/fill = SubResource("progress_fill")
ProgressBar/font_sizes/font_size = 14

; --- LineEdit ---
LineEdit/styles/normal = SubResource("line_edit_normal")
LineEdit/colors/font_color = Color(0.92, 0.88, 0.78, 1)
LineEdit/colors/caret_color = Color(0.95, 0.8, 0.5, 1)
LineEdit/font_sizes/font_size = 18

; --- PopupPanel/AcceptDialog ---
PopupPanel/styles/panel = SubResource("popup_panel")
AcceptDialog/styles/panel = SubResource("popup_panel")
ConfirmationDialog/styles/panel = SubResource("popup_panel")

; --- RichTextLabel ---
RichTextLabel/colors/default_color = Color(0.92, 0.88, 0.78, 1)
RichTextLabel/font_sizes/normal_font_size = 18

; --- VBoxContainer/HBoxContainer ---
VBoxContainer/constants/separation = 8
HBoxContainer/constants/separation = 8

; --- ScrollContainer ---
ScrollContainer/constants/separation = 4
